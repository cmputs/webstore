{
  "info": {
    "_postman_id": "5b102f6e-8867-4a0f-9654-94057217189e",
    "name": "Mallow & Moon - Tutorial Product API",
    "description": "Thunder Client can import this Postman v2.1 collection. Covers the tutorial's product API checks: create a product, list products, and fetch one product. Cart and order endpoints are not part of the tutorial API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create plushie (POST)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mallow Bunny\",\n  \"description\": \"A floppy-eared cuddle buddy for slow, cozy mornings.\",\n  \"price\": 89.90,\n  \"stockQuantity\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Expected: 201 Created and a JSON product containing its generated id. Copy that id into the productId collection variable before running Fetch one product."
      },
      "response": []
    },
    {
      "name": "List products (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Expected: 200 OK and a JSON array of products."
      },
      "response": []
    },
    {
      "name": "Fetch one product by id (GET)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        },
        "description": "Expected: 200 OK and one JSON product. Set productId to the id returned by Create plushie."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ]
}
